# Dashboard dev server (bun run dev, http://localhost:5173) forwards /api
# and /install to a running Pyo API: http://localhost:8000 for the Pyo in
# k3s, or the default below for one run with Cargo. Everything server-side
# is the Rust API in crates/pyo-api; in k3s it serves the built dashboard.
PYO_API_URL=http://127.0.0.1:8071

# ── Rust API (crates/pyo-api), when run outside k3s ─────────────────────
# DATABASE_URL=postgres://pyo:PASSWORD@127.0.0.1:5432/pyo
# LISTEN_ADDR=0.0.0.0:8071
# PYO_WEB_DIR=dash/dist/client
# URL agents dial out to, and the agent image the install manifest uses.
# PYO_AGENT_API_URL=http://pyo.pyo-system.svc:8000
# PYO_AGENT_IMAGE=127.0.0.1:5005/pyo/agent:dev
# Agents update their own limits when Pyo is updated. Pyo Cloud (a Pyo that
# serves other people's clusters) sets it to false.
# PYO_AGENT_SELF_UPDATE=true
# Mark the session cookie Secure (set when served over HTTPS).
# PYO_COOKIE_SECURE=false
# The first admin's password (admin@pyo.local). Left empty, Pyo generates one
# and logs it once. Either way, it has to be replaced on first sign-in.
# PYO_ADMIN_PASSWORD=

# Let anyone create an account. Off by default: only invited people can sign up.
# PYO_ALLOW_SIGNUP=true

# Teams may point registry logins, backup buckets and secret stores at private
# networks (LAN, tailnet). Pyo Cloud (a Pyo that serves other people's teams)
# sets it to false, so one team can't probe Pyo's network.
# PYO_ALLOW_PRIVATE_NETWORKS=true
