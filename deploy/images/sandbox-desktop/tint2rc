# The desktop's panel: launchers for the terminal and Chromium, the open
# windows and a clock.

# Backgrounds: 1 the panel, 2 a window's button, 3 the active one.
rounded = 0
border_width = 0
background_color = #1d2127 100
border_color = #000000 0

rounded = 4
border_width = 0
background_color = #2f353e 100
border_color = #000000 0

rounded = 4
border_width = 0
background_color = #46505c 100
border_color = #000000 0

panel_items = LTC
panel_size = 100% 36
panel_margin = 0 0
panel_padding = 6 4 8
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
wm_menu = 1
panel_dock = 0
