@@ -0,0 +1,64 @@
+package v1beta2
+
+import (
+	"testing"
+
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+func TestNamePrefix(t *testing.T) {
+	cases := []struct {
+		annotations map[string]string
+		prefix      string
+		sts         string
+		pod         string
+		cronJob     string
+		myCnf       string
+	}{
+		{nil, "moco-", "moco-test", "moco-test-1", "moco-backup-test", "moco-my-cnf-test"},
+		{map[string]string{NamePrefixAnnotation: "moco-"}, "moco-", "moco-test", "moco-test-1", "moco-backup-test", "moco-my-cnf-test"},
+		{map[string]string{NamePrefixAnnotation: ""}, "", "test", "test-1", "backup-test", "my-cnf-test"},
+		{map[string]string{NamePrefixAnnotation: "db-"}, "db-", "db-test", "db-test-1", "db-backup-test", "db-my-cnf-test"},
+	}
+	for _, c := range cases {
+		r := &MySQLCluster{ObjectMeta: metav1.ObjectMeta{Name: "test", Namespace: "ns", Annotations: c.annotations}}
+		if got := r.NamePrefix(); got != c.prefix {
+			t.Errorf("NamePrefix() = %q, want %q", got, c.prefix)
+		}
+		if got := r.PrefixedName(); got != c.sts {
+			t.Errorf("PrefixedName() = %q, want %q", got, c.sts)
+		}
+		if got := r.PodName(1); got != c.pod {
+			t.Errorf("PodName(1) = %q, want %q", got, c.pod)
+		}
+		if got := r.BackupCronJobName(); got != c.cronJob {
+			t.Errorf("BackupCronJobName() = %q, want %q", got, c.cronJob)
+		}
+		if got := r.MyCnfSecretName(); got != c.myCnf {
+			t.Errorf("MyCnfSecretName() = %q, want %q", got, c.myCnf)
+		}
+		if got := r.UserSecretName(); got != c.sts {
+			t.Errorf("UserSecretName() = %q, want %q", got, c.sts)
+		}
+		if got := r.PrimaryServiceName(); got != c.sts+"-primary" {
+			t.Errorf("PrimaryServiceName() = %q", got)
+		}
+		// Names in the controller's namespace never change.
+		if got := r.CertificateName(); got != "moco-agent-ns.test" {
+			t.Errorf("CertificateName() = %q", got)
+		}
+	}
+}
+
+func TestValidateNamePrefix(t *testing.T) {
+	for _, ok := range []string{"", "moco-", "db-", "x", "a1-"} {
+		if err := ValidateNamePrefix(ok); err != nil {
+			t.Errorf("%q: %v", ok, err)
+		}
+	}
+	for _, bad := range []string{"-", "-x", "Moco-", "a.b-", "a_b"} {
+		if err := ValidateNamePrefix(bad); err == nil {
+			t.Errorf("%q: no error", bad)
+		}
+	}
+}
