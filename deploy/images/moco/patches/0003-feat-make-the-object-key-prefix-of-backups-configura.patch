diff --git a/backup/key.go b/backup/key.go
index 0483731..9833ddc 100644
--- a/backup/key.go
+++ b/backup/key.go
@@ -2,17 +2,29 @@ package backup
 
 import (
 	"path"
+	"strings"
 	"time"
 
 	"github.com/cybozu-go/moco/pkg/constants"
 )
 
-const prefix = "moco"
+// DefaultKeyPrefix is the first part of the object keys of backups when
+// no other is given.
+const DefaultKeyPrefix = "moco"
 
-func calcKey(clusterNS, clusterName, filename string, dt time.Time) string {
-	return path.Join(prefix, clusterNS, clusterName, dt.UTC().Format(constants.BackupTimeFormat), filename)
+// keyRoot returns prefix without leading and trailing slashes, or
+// DefaultKeyPrefix when it is empty.
+func keyRoot(prefix string) string {
+	if p := strings.Trim(prefix, "/"); p != "" {
+		return p
+	}
+	return DefaultKeyPrefix
 }
 
-func calcPrefix(clusterNS, clusterName string) string {
-	return path.Join(prefix, clusterNS, clusterName) + "/"
+func calcKey(prefix, clusterNS, clusterName, filename string, dt time.Time) string {
+	return path.Join(keyRoot(prefix), clusterNS, clusterName, dt.UTC().Format(constants.BackupTimeFormat), filename)
+}
+
+func calcPrefix(prefix, clusterNS, clusterName string) string {
+	return path.Join(keyRoot(prefix), clusterNS, clusterName) + "/"
 }
diff --git a/backup/key_test.go b/backup/key_test.go
new file mode 100644
index 0000000..85c04ac
--- /dev/null
+++ b/backup/key_test.go
@@ -0,0 +1,24 @@
+package backup
+
+import (
+	"testing"
+	"time"
+)
+
+func TestKeys(t *testing.T) {
+	dt := time.Date(2026, 11, 10, 3, 4, 5, 0, time.UTC)
+	cases := []struct{ prefix, key, dir string }{
+		{"", "moco/ns/db/20261110-030405/dump.tar", "moco/ns/db/"},
+		{"moco", "moco/ns/db/20261110-030405/dump.tar", "moco/ns/db/"},
+		{"teams/t1/databases", "teams/t1/databases/ns/db/20261110-030405/dump.tar", "teams/t1/databases/ns/db/"},
+		{"/backups/", "backups/ns/db/20261110-030405/dump.tar", "backups/ns/db/"},
+	}
+	for _, c := range cases {
+		if got := calcKey(c.prefix, "ns", "db", "dump.tar", dt); got != c.key {
+			t.Errorf("calcKey(%q) = %q, want %q", c.prefix, got, c.key)
+		}
+		if got := calcPrefix(c.prefix, "ns", "db"); got != c.dir {
+			t.Errorf("calcPrefix(%q) = %q, want %q", c.prefix, got, c.dir)
+		}
+	}
+}
