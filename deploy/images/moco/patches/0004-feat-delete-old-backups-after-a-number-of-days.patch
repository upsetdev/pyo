+			}
+		}
+		return nil
 	},
 }
 
 func init() {
+	backupCmd.Flags().IntVar(&retentionDays, "retention-days", 0, "After the backup, delete the backups that no restore within this many days needs (0 keeps every backup)")
 	rootCmd.AddCommand(backupCmd)
 }
