diff --git a/backup/retention.go b/backup/retention.go
new file mode 100644
index 0000000..5dbf213
--- /dev/null
+++ b/backup/retention.go
@@ -0,0 +1,77 @@
+package backup
+
+import (
+	"context"
+	"fmt"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/cybozu-go/moco/pkg/constants"
+)
+
+// expiredKeys returns the keys under dir ("<prefix>/<namespace>/<name>/")
+// that no restore to a time after cutoff needs.
+//
+// Each backup is a directory "<dir><YYYYMMDD-hhmmss>/" with the full dump
+// taken at that time and the binary logs from then until the next backup.
+// A restore to a time T uses the newest backup taken at or before T, so
+// restoring to any time after cutoff needs the newest backup taken at or
+// before cutoff and every later one.  The older backups are expired.
+// Keys that are not in a backup directory are never expired.
+func expiredKeys(keys []string, dir string, cutoff time.Time) []string {
+	byTime := make(map[time.Time][]string)
+	for _, k := range keys {
+		rest, ok := strings.CutPrefix(k, dir)
+		if !ok {
+			continue
+		}
+		name, _, ok := strings.Cut(rest, "/")
+		if !ok {
+			continue
+		}
+		t, err := time.Parse(constants.BackupTimeFormat, name)
+		if err != nil {
+			continue
+		}
+		byTime[t] = append(byTime[t], k)
+	}
+
+	var keep time.Time
+	for t := range byTime {
+		if !t.After(cutoff) && t.After(keep) {
+			keep = t
+		}
+	}
+
+	var expired []string
+	for t, ks := range byTime {
+		if t.Before(keep) {
+			expired = append(expired, ks...)
+		}
+	}
+	sort.Strings(expired)
+	return expired
+}
+
+// DeleteExpired deletes the backups of the cluster that no restore to a
+// time within `retention` of the last backup needs.
+func (bm *BackupManager) DeleteExpired(ctx context.Context, retention time.Duration) error {
+	dir := calcPrefix(bm.keyPrefix, bm.cluster.Namespace, bm.cluster.Name)
+	keys, err := bm.bucket.List(ctx, dir)
+	if err != nil {
+		return fmt.Errorf("failed to list object keys: %w", err)
+	}
+
+	now := bm.startTime
+	if now.IsZero() {
+		now = time.Now().UTC()
+	}
+	for _, key := range expiredKeys(keys, dir, now.Add(-retention)) {
+		if err := bm.bucket.Delete(ctx, key); err != nil {
+			return fmt.Errorf("failed to delete %s: %w", key, err)
+		}
+		bm.log.Info("deleted an expired backup", "key", key)
+	}
+	return nil
+}
diff --git a/backup/retention_test.go b/backup/retention_test.go
new file mode 100644
index 0000000..f4ca704
--- /dev/null
+++ b/backup/retention_test.go
@@ -0,0 +1,49 @@
+package backup
+
+import (
+	"slices"
+	"testing"
+	"time"
+)
+
+func TestExpiredKeys(t *testing.T) {
+	dir := "teams/t1/databases/ns/db/"
+	keys := []string{
+		dir + "20261101-030000/dump.tar",
+		dir + "20261101-030000/binlog.tar.zst",
+		dir + "20261102-030000/dump.tar",
+		dir + "20261102-030000/binlog.tar.zst",
+		dir + "20261103-030000/dump.tar",
+		dir + "20261103-030000/binlog.tar.zst",
+		dir + "20261104-030000/dump.tar",
+		dir + "not-a-backup/file",
+		dir + "file",
+		"teams/t1/databases/ns/db2/20261101-030000/dump.tar",
+	}
+
+	// Restoring to any time after Nov 2 12:00 needs the backup of Nov 2 03:00.
+	cutoff := time.Date(2026, 11, 2, 12, 0, 0, 0, time.UTC)
+	got := expiredKeys(keys, dir, cutoff)
+	want := []string{dir + "20261101-030000/binlog.tar.zst", dir + "20261101-030000/dump.tar"}
+	if !slices.Equal(got, want) {
+		t.Errorf("expiredKeys() = %v, want %v", got, want)
+	}
+
+	// A backup taken exactly at the cutoff is the one kept.
+	cutoff = time.Date(2026, 11, 3, 3, 0, 0, 0, time.UTC)
+	got = expiredKeys(keys, dir, cutoff)
+	if len(got) != 4 || slices.Contains(got, dir+"20261103-030000/dump.tar") {
+		t.Errorf("expiredKeys() = %v", got)
+	}
+
+	// Nothing taken before the cutoff: nothing expires.
+	if got := expiredKeys(keys, dir, time.Date(2026, 10, 1, 0, 0, 0, 0, time.UTC)); len(got) != 0 {
+		t.Errorf("expiredKeys() = %v, want none", got)
+	}
+
+	// The newest backup is never expired.
+	got = expiredKeys(keys, dir, time.Date(2027, 1, 1, 0, 0, 0, 0, time.UTC))
+	if slices.Contains(got, dir+"20261104-030000/dump.tar") || len(got) != 6 {
+		t.Errorf("expiredKeys() = %v", got)
+	}
+}
