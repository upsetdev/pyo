# The k3s that Pyo installs, and the one each release is tested with. A
# release changes it on purpose, never by itself: see "Bump k3s" in
# RELEASING.md.
#
# - PYO_K3S_INSTALLER_SHA256: k3s's install.sh at that version's tag
#   (https://raw.githubusercontent.com/k3s-io/k3s/<version>/install.sh)
# - PYO_K3S_SHA256_AMD64 / _ARM64: the k3s and k3s-arm64 binaries of that
#   GitHub release (as in its sha256sum-amd64.txt and sha256sum-arm64.txt)
#
# release-manifest.ts carries these into release.json (deploy/install.sh
# reads them there); connect.sh, join.sh and scripts/join-node.sh carry a
# copy, and scripts/setup-host.sh reads this file. `cargo test -p pyo-api`
# fails while a copy differs.
PYO_K3S_VERSION=v1.37.2+k3s1
PYO_K3S_INSTALLER_SHA256=ed01f89fd977bf20ac1516bbebf8370bf3ddbaa55dac8aba610956a4c78cc00b
PYO_K3S_SHA256_AMD64=265b3ee6a3198ef14033c63ef46cbb32370d83795199fb6d1b01f21575eddbda
PYO_K3S_SHA256_ARM64=a779ccf1e5e2e33a62f5a29c2f1c0bbf99431e100579d4c10f0aa0742a6aa84b
